{
    "framework": "vite",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "trailingSlash": false,
    "rewrites": [
        {
            "source": "/productos",
            "destination": "/productos.html"
        },
        {
            "source": "/productos-royal",
            "destination": "/productos-royal.html"
        },
        {
            "source": "/aviso-legal",
            "destination": "/aviso-legal.html"
        },
        {
            "source": "/terminos-y-condiciones",
            "destination": "/terminos-y-condiciones.html"
        },
        {
            "source": "/politicas-de-privacidad",
            "destination": "/politicas-de-privacidad.html"
        },
        {
            "source": "/politica-de-cookies",
            "destination": "/politica-de-cookies.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=63072000; includeSubDomains; preload"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "SAMEORIGIN"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=()"
                },
                {
                    "key": "Cross-Origin-Opener-Policy",
                    "value": "same-origin"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}
